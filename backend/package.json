    "binary-extensions": "^2.3.0",
    "brace-expansion": "^1.1.12",
    "braces": "^3.0.3",
    "buffer-from": "^1.1.2",
    "chokidar": "^3.6.0",
    "concat-map": "^0.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "create-require": "^1.1.1",
    "diff": "^4.0.2",
