{
  "name": "my-node-ts-app",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && npm run copy-proto",
    "copy-proto": "cd src && find . -name \"*.proto\" -exec cp --parents {} ../dist/ \\;",
    "start": "node dist/server.js",
    "db:up": "docker-compose -f docker-compose.db.yml --env-file .env up -d",
    "db:down": "docker-compose -f docker-compose.db.yml --env-file .env down",
    "db:reset": "docker-compose -f docker-compose.db.yml --env-file .env down && docker-compose -f docker-compose.db.yml --env-file .env up -d && npx prisma migrate reset --force"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.9",
    "copyfiles": "^2.4.1",
    "prisma": "^6.13.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
