generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  username      String          @unique
  email         String          @unique
  password      String
  createdAt     DateTime        @default(now())
  comments      Comment[]
  history       History[]
  parameterSets ParameterSet[]
  stars         Star[]
  trainds       Traind[]
  preference    UserPreference?

  @@map("users")
}

model Traind {
  id             String         @id @default(uuid())
  postId         String
  subreddit      String
  createdAt      DateTime       @default(now())
  isPublic       Boolean        @default(true)
  parameterSetId String
  result         Json
  userId         String
  title          String
  status         String         @default("pending")
  comments       Comment[]
  history        History[]
  parameterSets  ParameterSet[]
  stars          Star[]
  user           User           @relation(fields: [userId], references: [id])

  @@map("trainds")
}

model Star {
  id        String   @id @default(uuid())
  userId    String
  traindId  String
  createdAt DateTime @default(now())
  traind    Traind   @relation(fields: [traindId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, traindId])
  @@map("stars")
}

model History {
  id       String   @id @default(uuid())
  userId   String
  traindId String
  viewedAt DateTime @default(now())
  traind   Traind   @relation(fields: [traindId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, traindId])
  @@map("history")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  createdAt DateTime  @default(now())
  userId    String
  traindId  String
  parentId  String?
  parent    Comment?  @relation("CommentReply", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReply")
  traind    Traind    @relation(fields: [traindId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("comments")
}

model ParameterSet {
  id         String   @id @default(uuid())
  name       String
  parameters Json
  createdAt  DateTime @default(now())
  userId     String
  traindId   String?
  traind     Traind?  @relation(fields: [traindId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("parameter_sets")
}

model UserPreference {
  id                         String  @id @default(uuid())
  userId                     String  @unique
  theme                      String  @default("theme-cool-white")
  makeTraindsPublicAsDefault Boolean @default(true)
  emailNotifications         Boolean @default(true)
  user                       User    @relation(fields: [userId], references: [id])

  @@map("user_preferences")
}

model Help {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  @@map("helps")
}
