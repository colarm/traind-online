    "data_clustering": {
      "description": "General data clustering analysis",
      "required_params": ["data_source"],
      "optional_params": [
        "feature_columns",
        "algorithm",
        "hdbscan_params",
        "preprocessing_params",
        "model_params"
      ],
      "default_params": {
        "algorithm": "hdbscan",
        "feature_columns": ["x", "y"],
        "hdbscan_params": {
          "min_cluster_size": 5,
          "min_samples": 3,
          "metric": "euclidean",
          "cluster_selection_epsilon": 0.0,
          "alpha": 1.0
        },
        "preprocessing_params": {
          "normalize": true,
          "remove_outliers": true,
          "outlier_threshold": 3.0
        },
        "model_params": {
          "random_state": 42,
          "n_jobs": -1
        }
      }
    }
