{
  "task_configs": {
    "reddit_analysis": {
      "description": "Analyse Reddit posts for clustering and sentiment",
      "required_params": [],
      "optional_params": [
        "max_comments",
        "comment_limit",
        "skip_removed",
        "skip_deleted",
        "min_score",
        "hdbscan_params",
        "preprocessing_params",
        "model_params",
        "summary_params",
        "sentiment_words",
        "topic_keywords",
        "stop_words",
        "reddit_fetch_params"
      ],
      "default_params": {
        "max_comments": 1000,
        "comment_limit": null,
        "skip_removed": true,
        "skip_deleted": true,
        "min_score": -10,
        "hdbscan_params": {
          "min_cluster_size": 2,
          "min_samples": 1,
          "metric": "euclidean",
          "cluster_selection_epsilon": 0.01,
          "alpha": 1.0
        },
        "preprocessing_params": {
          "min_comment_length": 15,
          "min_word_count": 3,
          "filter_prefixes": ["this", "i think"],
          "filter_deleted": true,
          "filter_removed": true
        },
        "model_params": {
          "sentence_transformer_model": "all-MiniLM-L6-v2",
          "batch_size": 32,
          "normalization": "l2"
        },
        "summary_params": {
          "top_clusters_display": 25,
          "keywords_per_cluster": 6,
          "enhanced_keywords": 10,
          "sample_comments_per_cluster": 5
        },
